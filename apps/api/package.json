{
  "name": "@xadrez/api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/config": "latest",
    "@nestjs/core": "latest",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "latest",
    "@nestjs/platform-socket.io": "latest",
    "@nestjs/websockets": "latest",
    "@prisma/client": "6.19.2",
    "@xadrez/shared": "workspace:*",
    "chess.js": "latest",
    "passport": "latest",
    "passport-google-oauth20": "latest",
    "passport-jwt": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "socket.io": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/passport-google-oauth20": "latest",
    "@types/passport-jwt": "latest",
    "@types/supertest": "latest",
    "prisma": "6.19.2",
    "supertest": "latest",
    "tsx": "latest",
    "vitest": "latest"
  }
}
